# В dev можно оставить пустым: запросы к /api/... идут через прокси Vite (см. vite.config.js, VITE_DEV_PROXY).
# Для production сборки — полный URL бэкенда, например:
# VITE_API_BASE=http://192.168.1.157:8001

VITE_API_BASE=

# Цель прокси в режиме разработки (только dev-сервер Vite)
# VITE_DEV_PROXY=http://192.168.1.157:8001
